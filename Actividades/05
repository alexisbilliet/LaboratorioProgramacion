using System;

class Program
{
    static void Main()
    {
        int Venta;
        int TotalVentas = 0;
        int MayorVenta = 0;
        int VendedorMayor = 0;

        for (int i = 1; i <= 20; i++)
        {
            for (int x = 1; x <= 15; x++)
            {
                Console.Write($"Ingrese las ventas del vendedor {i} del dia {x}: ");
                Venta = Convert.ToInt32(Console.ReadLine());

                TotalVentas += Venta;

                if (Venta > MayorVenta)
                {
                    MayorVenta = Venta;
                    VendedorMayor = i;
                }
            }
        }

        Console.WriteLine($"Total de unidades vendidas: {TotalVentas}");
        Console.WriteLine($"El vendedor con la mayor venta diaria fue el vendedor {VendedorMayor}.");
        Console.WriteLine($"La mayor venta diaria fue de {MayorVenta} unidades.");
    }
}
