using System.Runtime.Intrinsics.Arm;

namespace Ejercicio
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int aux = 0;
            int MayorCant = 0;
            double MayorP = 0;
            int Codigo = 0;
            int cant = 0;
            int Factura= 0;
            double precio = 0;
            Console.WriteLine("Ingrese el Numero de factura: ");
            Factura = Convert.ToInt16(Console.ReadLine());
            while (true)
            {
                Console.WriteLine("Ingrese el codigo del producto(999 para salir): ");
                Codigo = Convert.ToInt32(Console.ReadLine());
                if (Codigo == 999)
                    break;
                Console.WriteLine("Ingrese la cantidad de productos comprados");
                cant = Convert.ToInt16(Console.ReadLine());
                Console.WriteLine("Ingrese el precio unitario de ese producto");
                precio = Convert.ToDouble(Console.ReadLine());
                precio = precio * cant;
                if (precio > MayorP)
                {
                    MayorP = precio;
                    aux = Codigo;
                }
                if (cant > MayorCant)
                {
                    MayorCant = cant;
                }
            }
            Console.WriteLine($"El producto Con el codigo {aux} fue el mas vendido con {MayorCant} productos");
            Console.WriteLine($"El mayor importe vendido fue de {MayorP}");
        }
    }
}
