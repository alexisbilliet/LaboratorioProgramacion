using System.Runtime.Intrinsics.Arm;

namespace Ejercicio
{
    internal class Program
    {
        static void Main(string[] args)
        {
            double TP = 0;
            double Y;
            double[] Promedios = new double[50];
            int Contador = 0;
            double mayor = 0;
            int aux = 0;
            double suma1 = 0;
            int Contador2 = 0;
            for (int i = 0; i < 2; i++)
            {
                double suma = 0;
                int x = 0;
                do
                {
                    Console.WriteLine($"Ingrese la Nota del TP del alumno {i}: ");
                    TP = Convert.ToDouble(Console.ReadLine());
                } while (TP < 0 || TP > 10);
                if (TP >= 6)
                    Contador++;
                Console.WriteLine("(Ingrese un Valor Negativo Para Salir)");
                while (true)
                {
                    x++;
                    do
                    {
                        Console.WriteLine($"Ingrese la Nota {x + 1}: ");
                        Y = Convert.ToDouble(Console.ReadLine());
                    } while (Y > 10);
                    if (Y < 0)
                        break;
                    suma = suma + Y;
                }
                if (x <= 2)
                    Contador2++;
                suma = suma + TP;
                Promedios[i] = suma / x;
            }
            for (int i = 0; i < 2; i++)
            {
                suma1 += Promedios[i];
                if(mayor < Promedios[i])
                {
                    mayor = Promedios[i];
                    aux = i;
                }
                Console.WriteLine($"Promedio de el Alumno {i + 1}:{Promedios[i]}  ");
            }
            Console.WriteLine($"Alumno con mayor Promedio: {aux+1}, con {mayor}");
            Console.WriteLine($"Promedio general del curso: {suma1 / 2}");
            Console.WriteLine($"Cantidad de Alumnos con menos de 2 Notas: {Contador2}");
            Console.WriteLine($"Cantidad de Alumnos que aprobaron el TP: {Contador}");
        }
    }
}
