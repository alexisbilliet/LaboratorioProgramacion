using System;
namespace ConsoleApp2
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int[] vector = new int[6];
            int[,] matriz = new int[3, 6];
            bool listo = false;
            for (int i = 0; i < 3; i++)
            {
                for (int y = 0; y < vector.Length; y++)
                    vector[y] = 0;
                Console.WriteLine("Ingrese Los 6 Numeros del Sorteo " + i + ": ");
                for (int x = 0; x < 6; x++)
                {
                    do
                    {
                        listo = false;
                        Console.WriteLine("Ingrese el N°: " + x);
                        matriz[i, x] = int.Parse(Console.ReadLine());
                        if (vector.Contains(matriz[i, x]))
                        {
                            Console.WriteLine("El valor ingresado esta repetido");
                        }
                        else
                            listo = true;

                        vector[x] = matriz[i, x];
                    }
                    while (listo == false || matriz[i, x] <0  || matriz[i, x] > 42);

                }

            }



            for (int v = 0; v < 3; v++)
            {
                Console.WriteLine();
                for (int x = 0; x < 6; x++)
                {
                    Console.Write(matriz[v, x] + "\t");
                }
            }


        }
    }
}
