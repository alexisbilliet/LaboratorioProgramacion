using System;

public class HelloWorld
{
    public static void Main()
    {
        int[] numeros = new int[5];
        int opcion;

        do
        {
            Console.WriteLine("1 Cargar vector");
            Console.WriteLine("2 Mostrar vector");
            Console.WriteLine("3 Buscar numero");
            Console.WriteLine("4 Sumar elementos");
            Console.WriteLine("5 Terminar");
            Console.Write("Opcion: ");

            opcion = Convert.ToInt32(Console.ReadLine());

            switch(opcion)
            {
                case 1:

                    for(int i = 0; i < numeros.Length; i++)
                    {
                        Console.Write($"Ingrese el valor para la posicion {i}: ");
                        numeros[i] = Convert.ToInt16(Console.ReadLine());
                    }

                    break;

                case 2:

                    Console.WriteLine("Contenido del vector:");

                    foreach(int n in numeros)
                    {
                        Console.WriteLine(n);
                    }

                    break;

                case 3:

                    Console.Write("Numero a buscar: ");
                    int buscado = Convert.ToInt32(Console.ReadLine());

                    bool encontrado = false;

                    for(int i = 0; i < numeros.Length; i++)
                    {
                        if(numeros[i] == buscado)
                        {
                            Console.WriteLine($"Encontrado en el indice {i}");
                            encontrado = true;
                            break;
                        }
                    }

                    if(!encontrado)
                    {
                        Console.WriteLine("Numero no encontrado");
                    }

                    break;

                case 4:

                    int suma = 0;

                    for(int i = 0; i < numeros.Length; i++)
                    {
                        suma += numeros[i];
                    }

                    Console.WriteLine($"La suma es: {suma}");

                    break;

                case 5:

                    Console.WriteLine("Fin del programa");

                    break;

                default:

                    Console.WriteLine("Opcion invalida");

                    break;
            }

        } while(opcion != 5);
    }
}
