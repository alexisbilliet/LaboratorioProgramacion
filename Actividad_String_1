namespace ConsoleApp1
{
    internal class Program
    {
        static string cadena2;
        static string cadena = "";
        static  int numero = 0;
        static void IngresarDatos()
        {
            bool ok = false;
            while (cadena.Length < 15)
            {
                Console.Write("Ingrese una cadena de caracteres-(Min 15)-: ");
                cadena = Console.ReadLine();
            }

            while (!ok)
            {
                Console.Write("Ingrese un Caracter: ");
                cadena2 = Console.ReadLine();
                if (cadena2.Length == 1)
                    ok = true;
            }

            while (numero < 2 || numero > 6)
            {
                Console.Write("Ingrese un numero del 3 al 5: ");
                numero = Convert.ToInt16(Console.ReadLine());
            }
        }
        static void Main(string[] args)
        {
            IngresarDatos();
            Console.WriteLine(cadena + cadena2);
            Console.WriteLine(cadena.ToUpper() + " " + cadena2.ToLower());
            Console.WriteLine(cadena.Substring(0, numero));
            Console.WriteLine(cadena.Substring(cadena.Length - numero));
            Console.WriteLine(cadena.Substring(3, 1) + " " + cadena.Substring(9, 1) + " " + cadena.Substring(cadena.Length - 1));
        }

    }


}
