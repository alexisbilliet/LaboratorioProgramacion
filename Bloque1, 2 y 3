            }
        }
        static void Ejercicio3N()
        {
            while (true)
            {
                Console.WriteLine("Ingrese una frase");
                string frase = Console.ReadLine().ToLower();
        
                if (frase == "agusfortnite2008")
                {
                    break;
                }
        
                string a = "";
                string e = "";
                string i = "";
                string o = "";
                string u = "";
        
                for (int x = 0; x < frase.Length; x++)
                {
                    string letra = frase.Substring(x, 1);
        
                    if (letra == "a" || letra == "e" || letra == "i" || letra == "o" || letra == "u")
                    {
                        a = a + "a";
                        e = e + "e";
                        i = i + "i";
                        o = o + "o";
                        u = u + "u";
                    }
                    else
                    {
                        a = a + letra;
                        e = e + letra;
                        i = i + letra;
                        o = o + letra;
                        u = u + letra;
                    }
                }

                Console.WriteLine(a);
                Console.WriteLine(e);
                Console.WriteLine(i);
                Console.WriteLine(o);
                Console.WriteLine(u);
            }
        }
