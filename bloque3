        static void EjercicioG()
        {
            Random r = new Random();
        
            int secreto = r.Next(1, 101);
        
            int intentos = 0;
        
            while (true)
            {
                Console.WriteLine("Ingrese un numero");
                int num = Convert.ToInt32(Console.ReadLine());
        
                intentos=intentos+1;
        
                if (num < secreto)
                {
                    Console.WriteLine("Mas grande");
                }
                else if (num > secreto)
                {
                    Console.WriteLine("Mas chico");
                }
                else
                {
                    Console.WriteLine($"Acertaste en {intentos} intentos");
                    break;
                }
            }
        }
        static void EjercicioH()
        {
            Console.WriteLine("Ingrese una frase");
            string frase = Console.ReadLine();
        
            string[] palabras = frase.Split(' ');
        
            for (int i = 0; i < palabras.Length; i++)
            {
                string invertida = "";
        
                for (int j = palabras[i].Length - 1; j >= 0; j--)
                {
                    invertida = invertida + palabras[i].Substring(j, 1);
                }
        
                Console.WriteLine(invertida);
            }
        }
        static void EjercicioI()
        {
            Console.WriteLine("Ingrese una palabra");
            string palabra = Console.ReadLine().ToLower();
        
            for (int i = 0; i < palabra.Length; i++)
            {
                string letra = palabra.Substring(i, 1);
        
                int contador = 0;
        
                for (int j = 0; j < palabra.Length; j++)
                {
                    if (palabra.Substring(j, 1) == letra)
                    {
                        contador++;
                    }
                }
        
                Console.WriteLine($"{letra}: {contador}");
            }
        }
