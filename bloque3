        static void EjercicioA()
        {
            int votos1 = 0;
            int votos2 = 0;
            int votos3 = 0;
        
            while (true)
            {
                Console.WriteLine("1-Opcion A");
                Console.WriteLine("2-Opcion B");
                Console.WriteLine("3-Opcion C");
                Console.WriteLine("Escriba terminar para finalizar");
        
                string voto = Console.ReadLine();
        
                if (voto == "terminar")
                {
                    break;
                }
        
                if (voto == "1")
                {
                    votos1++;
                }
        
                if (voto == "2")
                {
                    votos2++;
                }
        
                if (voto == "3")
                {
                    votos3++;
                }
            }

            if (votos1 > votos2 && votos1 > votos3)
            {
                Console.WriteLine("Gano la opcion A");
            }
            else if (votos2 > votos1 && votos2 > votos3)
            {
                Console.WriteLine("Gano la opcion B");
            }
            else
            {
                Console.WriteLine("Gano la opcion C");
            }
        }
        static void EjercicioB()
        {
            Console.WriteLine("Ingrese un numero");
            int num = Convert.ToInt32(Console.ReadLine());
        
            if (num < 1)
            {
                Console.WriteLine("No se puede");
            }
            else
            {
                for (int i = 1; i <= num; i++)
                {
                    if (i % 2 != 0)
                    {
                        Console.WriteLine(i);
                    }
                }
            }
        }
        static void EjercicioC()
        {
            Console.WriteLine("Ingrese una palabra");
            string palabra = Console.ReadLine().ToLower();
        
            Console.WriteLine("Ingrese una letra");
            string letra = Console.ReadLine().ToLower();
        
            int contador = 0;
        
            for (int i = 0; i < palabra.Length; i++)
            {
                if (palabra.Substring(i, 1) == letra)
                {
                    contador=contador + 1;
                }
            }
        
            Console.WriteLine($"La letra aparece {contador} veces");
        }
        static void EjercicioD()
        {
            double saldo = 1000;
        
            while (true)
            {
                Console.WriteLine($"Saldo actual: {saldo}");
        
                Console.WriteLine("1-Depositar");
                Console.WriteLine("2-Retirar");
                Console.WriteLine("3-Salir");
        
                int opcion = Convert.ToInt32(Console.ReadLine());
        
                if (opcion == 3)
                {
                    break;
                }
        
                if (opcion == 1)
                {
                    Console.WriteLine("Monto");
                    double monto = Convert.ToDouble(Console.ReadLine());
        
                    saldo = saldo + monto;
                }
        
                if (opcion == 2)
                {
                    Console.WriteLine("Monto");
                    double monto = Convert.ToDouble(Console.ReadLine());
        
                    if (monto <= saldo)
                    {
                        saldo = saldo - monto;
                    }
                    else
                    {
                        Console.WriteLine("Fondos insuficientes");
                    }
                }
            }
        }
